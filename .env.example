# ---------------------------------------------------------------------------
# .env  --  the ONLY two variables the browser bundle may ever see.
#
# The anon key is public by design: it ships inside the JavaScript bundle and
# anyone can read it. Nothing in this application may rely on it being secret.
# All security rests on RLS policies and the authorization checks inside the
# SECURITY DEFINER functions in supabase/migrations/0006_functions.sql.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# .env.seed  --  NOT this file. Create it separately; it is gitignored.
#
# The service-role key bypasses RLS completely. It is used by
# `npm run db:seed` and nothing else. It must never appear in src/, never
# carry a VITE_ prefix (that would inline it into the bundle), and never be
# committed.
#
#   SUPABASE_URL=https://your-project-ref.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ---------------------------------------------------------------------------
