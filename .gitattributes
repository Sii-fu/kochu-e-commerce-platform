# LF everywhere. This is a JS/SQL project whose tooling assumes Unix endings,
# and a CRLF checkout makes bash read the trailing \r as part of each command
# ("$'\r': command not found") and shows every file as modified on Windows.
* text=auto eol=lf

*.sh   text eol=lf
*.sql  text eol=lf

# Binary assets must never be normalised.
*.png  binary
*.jpg  binary
*.webp binary
*.woff binary
*.woff2 binary
